<Project Sdk="Microsoft.NET.Sdk">

  <!-- Запуск на Windows -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Kuriatnyk.Desktop</RootNamespace>
    <AssemblyName>BoevoyKuryatnik</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Kuriatnyk\Assets\icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="NAudio.Wasapi" Version="2.4.0" />
    <PackageReference Include="NAudio.Core" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuriatnyk\Kuriatnyk.csproj" />
  </ItemGroup>

</Project>
